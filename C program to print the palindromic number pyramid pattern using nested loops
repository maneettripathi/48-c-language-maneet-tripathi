// Write a C program to print the palindromic number pyramid pattern using nested loops.
#include <stdio.h>

int main() {
    int i, j, space, num;
    for (i = 1; i <= 5; i++) {
        for (space = 1; space <= 5 - i; space++) {
            printf("  ");
        }
        num = i;
        for (j = 1; j <= i; j++) {
            printf("%d ", num++);
        }
        num = num - 2;
        for (j = 1; j < i; j++) {
            printf("%d ", num--);
        }
        printf("\n");
    }
    return 0;
}
