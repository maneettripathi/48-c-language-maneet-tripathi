// Write a C program that accepts the salary and age from the user and displays the same on the screen as output.
#include <stdio.h>

int main() {
    float salary;
    int age;
    printf("Enter your age: ");
    scanf("%d", &age);
    printf("Enter your salary: ");
    scanf("%f", &salary);
    printf("Age: %d\n", age);
    printf("Salary: %.2f\n", salary);
    return 0;
}
