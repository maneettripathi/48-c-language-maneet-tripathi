// Write a C program to find the GCD (Greatest Common Divisor) of two numbers.
#include <stdio.h>

int main() {
    int a, b, i, gcd;
    printf("Enter two integers: ");
    scanf("%d %d", &a, &b);
    for (i = 1; i <= a && i <= b; i++) {
        if (a % i == 0 && b % i == 0) {
            gcd = i;
        }
    }
    printf("GCD = %d\n", gcd);
    return 0;
}
