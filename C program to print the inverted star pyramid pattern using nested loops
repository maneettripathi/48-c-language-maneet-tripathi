// Write a C program to print the inverted star pyramid pattern using nested loops.
#include <stdio.h>

int main() {
    int i, j, space;
    for (i = 5; i >= 1; i--) {
        for (space = 0; space < 5 - i; space++) {
            printf("  ");
        }
        for (j = 1; j <= (2 * i - 1); j++) {
            printf("* ");
        }
        printf("\n");
    }
    return 0;
}
